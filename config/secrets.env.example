# Not loaded at runtime. Export these in the environment of the install scripts
# and of the Tomcat process. Do not commit real values.
#
# Derby user gaiandb. install-prereqs.sh writes this into Tomcat context.xml.
# create-database.sh uses it for the ij connection. No single quote, backtick,
# semicolon, backslash, or newline.
CISPACES_DERBY_PASSWORD=change-me
#
# PostgreSQL role intelanalysis. FEWS reads this when it connects.
# install-fact-extraction.sh sets the role password from it.
# No backslash or newline.
CISPACES_POSTGRES_PASSWORD=change-me
#
# RabbitMQ user intelanalysis. FEWS reads this when it connects.
# install-fact-extraction.sh sets the broker user from it.
# No backslash or newline.
CISPACES_RABBITMQ_PASSWORD=change-me
#
# Optional. Defaults to ${CISPACES}/config/key.properties, the one file
# install-prereqs.sh generates for every service.
# CISPACES_JWT_KEY_FILE=/path/to/cispaces/config/key.properties
